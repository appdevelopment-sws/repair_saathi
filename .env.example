# ==============================================================================
# REPAIR SAATHI - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (or '.env.local') and customize for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Defines runtime environment: 'development' | 'production' | 'test'
NODE_ENV=production

# The port on which the Next.js server listens (or mapped by Docker on the host)
PORT=3000

# Host binding interface (0.0.0.0 binds to all network interfaces, required for Docker)
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. BACKEND API & HOURLYHOUR CONNECTION CONFIGURATION
# ------------------------------------------------------------------------------
# BACKEND_INTERNAL_URL:
#   Used by Next.js Server Components and server-side API Route Handlers (/api/categories)
#   to communicate directly with the Hourlyhour backend server.
#
#   - In Local Docker:
#       BACKEND_INTERNAL_URL=http://host.docker.internal:8008
#   - In Local Dev (outside Docker / next dev):
#       BACKEND_INTERNAL_URL=http://localhost:8008
#   - In Production (When Hourlyhour Backend is deployed on live server):
#       BACKEND_INTERNAL_URL=https://api.yourdomain.com
#       (or e.g. https://backend.repairsaathi.in)
BACKEND_INTERNAL_URL=http://host.docker.internal:8008

# NEXT_PUBLIC_BACKEND_URL:
#   Exposed to browser client code for direct assets, image URLs, or socket connections.
#   - In Local Development:
#       NEXT_PUBLIC_BACKEND_URL=http://localhost:8008
#   - In Production:
#       NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
#       (or e.g. https://backend.repairsaathi.in)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8008

# ------------------------------------------------------------------------------
# 3. WEBSITE CANONICAL URL & SEO METADATA
# ------------------------------------------------------------------------------
# Primary domain for canonical tags, Open Graph images, sitemaps, and robots.txt
NEXT_PUBLIC_SITE_URL=https://repairsaathi.in

# ------------------------------------------------------------------------------
# 4. SUPPORT & CONTACT DETAILS (Used across header, footer & booking forms)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=+918235084930
NEXT_PUBLIC_CONTACT_EMAIL=contact@repairsaathi.in
NEXT_PUBLIC_WHATSAPP_NUMBER=918235084930
